<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Native ExoPlayer Texture View for Universal Android TV In-Tree Video Surface Rendering -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:shutter_background_color="@android:color/transparent"
        app:resize_mode="fit" />

    <!-- Error Notice Overlay -->
    <LinearLayout
        android:id="@+id/error_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unable to decode stream. Please try another link."
            android:textColor="#ff4d4d"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Custom Player Controls Overlay matching Web Player UI -->
    <RelativeLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_overlay_gradient"
        android:padding="24dp">

        <!-- Top Bar Header (Back Button & Title / Logo) -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/btn_player_control_bg"
                android:text="← Back"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:focusable="true"
                android:nextFocusDown="@+id/seek_bar"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <ImageView
                android:id="@+id/img_media_logo"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Footer Controls -->
        <LinearLayout
            android:id="@+id/footer_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- Scrubber Row (Current Time, SeekBar, Duration) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_current_time"
                    android:layout_width="65dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/player_seekbar_progress"
                    android:thumb="@drawable/player_seekbar_thumb"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btn_back"
                    android:nextFocusDown="@+id/btn_play_pause" />

                <TextView
                    android:id="@+id/txt_duration"
                    android:layout_width="65dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:gravity="end" />
            </LinearLayout>

            <!-- Lower Actions Row (Transport Controls + Audio/Subtitles Buttons) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <!-- Compact Transport Controls (Left / Center) -->
                <LinearLayout
                    android:id="@+id/transport_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_rewind_30"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_player_control_circle"
                        android:text="-30"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusRight="@+id/btn_rewind_10" />

                    <Button
                        android:id="@+id/btn_rewind_10"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/btn_player_control_circle"
                        android:text="-10"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusLeft="@+id/btn_rewind_30"
                        android:nextFocusRight="@+id/btn_play_pause" />

                    <ImageButton
                        android:id="@+id/btn_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/btn_main_play_bg"
                        android:src="@android:drawable/ic_media_pause"
                        android:scaleType="centerInside"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusLeft="@+id/btn_rewind_10"
                        android:nextFocusRight="@+id/btn_ff_10" />

                    <Button
                        android:id="@+id/btn_ff_10"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/btn_player_control_circle"
                        android:text="+10"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusLeft="@+id/btn_play_pause"
                        android:nextFocusRight="@+id/btn_ff_30" />

                    <Button
                        android:id="@+id/btn_ff_30"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_player_control_circle"
                        android:text="+30"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusLeft="@+id/btn_ff_10"
                        android:nextFocusRight="@+id/btn_audio" />
                </LinearLayout>

                <!-- Audio & Subtitles Controls (Right Aligned) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/btn_player_control_bg"
                        android:text="🔊 Audio"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusLeft="@+id/btn_ff_30"
                        android:nextFocusRight="@+id/btn_subtitles"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                    <Button
                        android:id="@+id/btn_subtitles"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/btn_player_control_bg"
                        android:text="💬 Subs"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:nextFocusUp="@+id/seek_bar"
                        android:nextFocusLeft="@+id/btn_audio"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
